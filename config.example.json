{
  "threshold_items": 10000,
  "threshold_size_bytes": 0,
  "poll_interval_seconds": 600,
  "auto_clean_enabled": true,
  "auto_clean_confirmed": false,
  "auto_update_on_signal": true,
  "confirm_before_clean": true,
  "confirmation_timeout_seconds": 10,
  "failure_backoff_seconds": 300,
  "excluded_roots": [],
  "start_on_login": false,
  "hotkey_enabled": true,
  "clean_sound_enabled": true,
  "theme": "auto",
  "log_max_bytes": 1048576,
  "log_backup_count": 5,
  "clean_scope": "vibecoding",
  "count_recursive": true,
  "garbage_path_patterns": [
    "*\\AppData\\Local\\Temp\\*",
    "*\\Windows\\Temp\\*",
    "*\\node_modules\\*",
    "*\\.venv\\*",
    "*\\venv\\*",
    "*\\site-packages\\*",
    "*\\__pycache__\\*",
    "*\\.pytest_cache\\*",
    "*\\.ruff_cache\\*",
    "*\\.mypy_cache\\*",
    "*\\.tox\\*",
    "*\\dist\\*",
    "*\\build\\*",
    "*\\target\\*",
    "*\\.next\\*",
    "*\\.nuxt\\*",
    "*\\.cache\\*",
    "*\\coverage\\*",
    "*\\.parcel-cache\\*",
    "*\\AppData\\Local\\pip\\cache\\*",
    "*\\AppData\\Local\\npm-cache\\*",
    "*\\AppData\\Local\\pnpm-store\\*",
    "*\\AppData\\Local\\Yarn\\Cache\\*",
    "*\\.gradle\\*",
    "*.pyc",
    "*.pyo",
    "*.tmp",
    "*.temp",
    "*.log",
    "*.bak",
    "*.crdownload",
    "*.part"
  ],
  "keep_path_patterns": [
    "*\\Desktop\\*",
    "*\\桌面\\*",
    "*\\Documents\\*",
    "*\\文档\\*",
    "*\\Downloads\\*",
    "*\\下载\\*",
    "*\\Pictures\\*",
    "*\\图片\\*",
    "*\\Music\\*",
    "*\\音乐\\*",
    "*\\Videos\\*",
    "*\\视频\\*",
    "*\\OneDrive\\*"
  ],
  "burst_enabled": true,
  "burst_window_seconds": 300,
  "burst_min_items": 50,
  "discard_zones": [
    "D:\\VibeCoding"
  ],
  "zone_min_items": 100,
  "zone_enabled": true
}
